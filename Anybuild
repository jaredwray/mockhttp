# The homepage is the Docula site. Anybuild only runs the build step before
# `pnpm prune --prod`, so that step has to produce site/dist while docula is
# still installed.

load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {
        "start": "node dist/index.mjs",
    },
    node_build_command = "pnpm run build && pnpm website:build",
    node_package_manager = "pnpm",
    node_server = "fastify",
    node_version = "24",
    pnpm_version = "12.4.1",
)

build = node_build(config)

node_serve(config, build, name = "mockhttp")
