{
	"$schema": "https://unpkg.com/wrangler@4.127.0/config-schema.json",
	"name": "mockhttp",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-27",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "mockhttp.org",
			"custom_domain": true
		}
	],
	"containers": [
		{
			"class_name": "MockHttpContainer",
			"image": "./Dockerfile",
			"max_instances": 5,
			"instance_type": "basic",
			"rollout_step_percentage": 100
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "MOCKHTTP_CONTAINER",
				"class_name": "MockHttpContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MockHttpContainer"]
		}
	]
}
